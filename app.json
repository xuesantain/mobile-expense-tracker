{
  "expo": {
    "name": "手机记账",
    "slug": "mobile-expense-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.local.mobileexpensetracker"
    },
    "android": {
      "package": "com.xuesantain.mobileexpensetracker",
      "versionCode": 1,
      "permissions": [
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-image-picker"
    ]
  }
}
